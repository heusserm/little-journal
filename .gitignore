# Xcode
# Any derived-data directory, not just the two that existed when this was
# written. `iosApp/dd-ipad/` was 2,190 files and 147MB, and it was only kept
# out of a commit because paths are staged explicitly rather than with -A.
iosApp/dd*/
iosApp/iosApp.xcodeproj/

# Xcode result bundles from -resultBundlePath
iosApp/cov.xcresult/
iosApp/*.xcresult/

# Python bytecode caches. One of these was committed by accident; .gitignore
# alone does not untrack what is already tracked, so it was git rm --cached.
__pycache__/
*.pyc

# Release artifacts, and fastlane run reports.
build/release/
fastlane/report.xml
fastlane/Preview.html
